# Public Sanity project. These defaults also live in sanity/env.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=oqf42bbg
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Google Tag Manager container. When unset, the consent banner and GTM are omitted.
# Consent Mode stays denied until the visitor accepts.
NEXT_PUBLIC_GTM_ID=

# Shared secret for POST /api/revalidate. Generate with: openssl rand -base64 32
# Set the same value in Vercel (Production and Preview) and as the Sanity webhook secret.
# Never commit a real value.
SANITY_REVALIDATE_SECRET=

# Desk (/admin). Agris sets these in Vercel. Do not commit real values.
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app. Callback: https://darznieks.com/api/auth/callback/github
# Also add the preview URL when you test a deployment.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# The only GitHub login that may open the desk. One username, not a list.
ADMIN_GITHUB_LOGIN=agrisdarznieks
# Server-only Sanity tokens. The write token never goes to the browser.
# A viewer token is enough for drafts. The editor token is required to save.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Test-only. Never set these on Vercel. The desk ignores them when VERCEL is set.
# ADMIN_E2E=1
# ADMIN_E2E_TOKEN=
# ADMIN_E2E_FIXTURES=1
